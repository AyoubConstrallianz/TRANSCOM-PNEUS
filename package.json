{
  "name": "transcom-pneus",
  "version": "1.0.0",
  "description": "Site web TRANSCOM PNEUS - Vente et réparation de pneus à domicile en Île-de-France",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --watch",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && node prisma/seed.js",
    "setup": "npm install && npm run db:push && npm run db:seed && npm run build:css",
    "postinstall": "prisma generate && tailwindcss -i ./src/css/input.css -o ./public/css/tailwind.css --minify"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "csrf-csrf": "^3.0.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.12",
    "sharp": "^0.33.3",
    "winston": "^3.12.0",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
