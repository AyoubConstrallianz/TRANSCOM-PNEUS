# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Base de données
# SQLite (développement) — laisser DATABASE_URL avec sqlite:
DATABASE_URL="file:./dev.db"
# PostgreSQL (production) — décommenter et remplir :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/transcom_pneus?schema=public"

# Sessions
SESSION_SECRET=changez_ce_secret_en_production_avec_une_chaine_aleatoire_longue

# Admin par défaut (créé lors du seed)
ADMIN_EMAIL=admin@transcompneus.fr
ADMIN_PASSWORD=Admin1234!

# Email (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=votre@email.com
MAIL_PASS=votre_mot_de_passe_application
MAIL_FROM="TRANSCOM PNEUS <contact@transcompneus.fr>"
MAIL_ADMIN=admin@transcompneus.fr

# Entreprise
COMPANY_PHONE=+33 1 XX XX XX XX
COMPANY_WHATSAPP=+33XXXXXXXXX
COMPANY_EMAIL=contact@transcompneus.fr
