<%- include('../../partials/header') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Réparation crevaison voiture à domicile",
  "description": "Réparation de crevaison voiture à domicile en Île-de-France. Pneu crevé, pneu à plat : intervention rapide sans vous déplacer.",
  "provider": { "@type": "AutoRepair", "name": "TRANSCOM PNEUS", "url": "https://transcompneus.fr", "telephone": "<%= phone %>" },
  "areaServed": { "@type": "State", "name": "Île-de-France" },
  "serviceType": "Réparation crevaison voiture"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Peut-on réparer un pneu crevé de voiture sans le remplacer ?", "acceptedAnswer": { "@type": "Answer", "text": "Oui, dans de nombreux cas une crevaison peut être réparée par l'intérieur avec un champignon ou une mèche professionnelle, sans remplacer le pneu. Notre technicien évalue la faisabilité sur place." } },
    { "@type": "Question", "name": "Ma voiture a un pneu crevé, puis-je rouler ?", "acceptedAnswer": { "@type": "Answer", "text": "Non, rouler avec un pneu crevé peut endommager la jante et compromettre votre sécurité. Appelez-nous, nous venons à vous pour réparer ou remplacer le pneu sur place." } },
    { "@type": "Question", "name": "Combien de temps dure la réparation d'une crevaison voiture ?", "acceptedAnswer": { "@type": "Answer", "text": "La réparation d'une crevaison simple prend environ 20 à 30 minutes sur place. Le remplacement complet du pneu prend environ 30 à 45 minutes." } }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://transcompneus.fr/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://transcompneus.fr/services" },
    { "@type": "ListItem", "position": 3, "name": "Crevaison voiture", "item": "https://transcompneus.fr/crevaison-voiture" }
  ]
}
</script>

<section class="bg-black border-b border-zinc-800 py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <nav class="text-sm text-zinc-500 mb-6">
      <a href="/" class="hover:text-yellow-400">Accueil</a> <span class="mx-2">›</span>
      <a href="/services" class="hover:text-yellow-400">Services</a> <span class="mx-2">›</span>
      <span class="text-zinc-300">Crevaison voiture</span>
    </nav>
    <div class="inline-flex items-center gap-2 border border-yellow-400/40 bg-yellow-400/10 rounded-full px-4 py-1.5 text-yellow-400 text-sm font-semibold mb-6 uppercase tracking-wider">
      <span class="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></span>
      Intervention rapide 7j/7
    </div>
    <h1 class="text-4xl md:text-5xl font-black text-white uppercase mb-4">Crevaison Voiture<br><span class="text-yellow-400">Réparation à Domicile</span></h1>
    <p class="text-zinc-300 text-lg max-w-2xl mb-8">Votre voiture a un pneu crevé ? TRANSCOM PNEUS intervient directement à votre adresse en Île-de-France pour réparer ou remplacer votre pneu sans vous déplacer au garage.</p>
    <div class="flex flex-wrap gap-4">
      <a href="/reservation" class="btn-primary text-base px-8 py-4">Réparer ma crevaison</a>
      <a href="tel:<%= phone %>" class="btn-secondary text-base px-8 py-4">Appeler en urgence</a>
    </div>
  </div>
</section>

<!-- Types de crevaison -->
<section class="py-16 bg-zinc-950">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl md:text-3xl font-black text-white uppercase mb-8">Types de crevaison voiture que nous traitons</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      <div class="card p-6">
        <h3 class="font-bold text-white text-lg mb-2">Crevaison par objet (clou, vis, verre)</h3>
        <p class="text-zinc-400">La cause la plus fréquente de crevaison voiture. Nous retirons l'objet et réparons le pneu par l'intérieur avec un champignon professionnel. Si la crevaison est sur le flanc, nous remplacons le pneu.</p>
      </div>
      <div class="card p-6">
        <h3 class="font-bold text-white text-lg mb-2">Fuite lente — pneu qui se dégonfle</h3>
        <p class="text-zinc-400">Votre pneu se dégonfle lentement ? Cela peut venir de la valve, du talon de jante ou d'une micro-perforation. Nous diagnostiquons et réparons le problème sur place.</p>
      </div>
      <div class="card p-6">
        <h3 class="font-bold text-white text-lg mb-2">Pneu éclaté ou déchiré</h3>
        <p class="text-zinc-400">Un pneu éclaté ne peut pas être réparé et doit être remplacé. Nous apportons un pneu neuf adapté à votre véhicule et l'installons sur place avec équilibrage.</p>
      </div>
      <div class="card p-6">
        <h3 class="font-bold text-white text-lg mb-2">Jante abîmée causant des fuites</h3>
        <p class="text-zinc-400">Une jante voilée ou fissurée peut provoquer une perte de pression. Notre technicien diagnostique le problème et vous conseille sur la solution adaptée.</p>
      </div>
    </div>
  </div>
</section>

<!-- Avantages -->
<section class="py-16 bg-black">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl md:text-3xl font-black text-white uppercase mb-8">Pourquoi choisir TRANSCOM PNEUS pour votre crevaison ?</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      <div class="card p-5 text-center">
        <span class="text-4xl mb-3 block">⏱️</span>
        <h3 class="font-bold text-white mb-2">Intervention en -2h</h3>
        <p class="text-zinc-400 text-sm">Pas besoin d'attendre la dépanneuse. Notre technicien vient réparer votre crevaison directement sur place.</p>
      </div>
      <div class="card p-5 text-center">
        <span class="text-4xl mb-3 block">🏠</span>
        <h3 class="font-bold text-white mb-2">On vient chez vous</h3>
        <p class="text-zinc-400 text-sm">Domicile, bureau, parking, bord de route — nous nous déplacons partout en Île-de-France.</p>
      </div>
      <div class="card p-5 text-center">
        <span class="text-4xl mb-3 block">💶</span>
        <h3 class="font-bold text-white mb-2">Devis gratuit</h3>
        <p class="text-zinc-400 text-sm">Diagnostic et devis gratuits avant toute intervention. Aucune mauvaise surprise.</p>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-16 bg-zinc-950">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl font-black text-white uppercase mb-8">Questions fréquentes — Crevaison voiture</h2>
    <div class="space-y-2">
      <details class="card group">
        <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-zinc-800/50 rounded-xl">
          <span class="font-semibold pr-4">Peut-on réparer un pneu crevé sans le remplacer ?</span>
          <svg class="w-5 h-5 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 text-zinc-300 leading-relaxed">Oui, dans de nombreux cas une crevaison peut être réparée par l'intérieur avec un champignon ou une mèche professionnelle, sans remplacer le pneu. Notre technicien évalue la faisabilité sur place.</div>
      </details>
      <details class="card group">
        <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-zinc-800/50 rounded-xl">
          <span class="font-semibold pr-4">Ma voiture a un pneu crevé, puis-je rouler ?</span>
          <svg class="w-5 h-5 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 text-zinc-300 leading-relaxed">Non, rouler avec un pneu crevé peut endommager la jante et compromettre votre sécurité. Appelez-nous, nous venons à vous pour réparer ou remplacer le pneu sur place.</div>
      </details>
      <details class="card group">
        <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-zinc-800/50 rounded-xl">
          <span class="font-semibold pr-4">Combien de temps dure la réparation d'une crevaison ?</span>
          <svg class="w-5 h-5 text-zinc-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="px-5 pb-5 text-zinc-300 leading-relaxed">La réparation d'une crevaison simple prend environ 20 à 30 minutes sur place. Le remplacement complet du pneu prend environ 30 à 45 minutes avec équilibrage inclus.</div>
      </details>
    </div>
  </div>
</section>

<!-- Zones -->
<section class="py-12 bg-black">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-xl font-bold text-white mb-6">Réparation crevaison voiture dans toute l'Île-de-France</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <% Object.entries(depts).forEach(([code, name]) => { %>
        <a href="/pneus-domicile/<%= code %>" class="card p-3 text-center hover:border-yellow-400/60 transition-all group">
          <span class="text-xl font-black text-yellow-400"><%= code %></span>
          <p class="text-zinc-400 text-xs mt-1"><%= name %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="py-20 bg-yellow-400">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl font-black text-black uppercase mb-4">Crevaison ? On s'en occupe.</h2>
    <p class="text-black/70 text-lg mb-8 font-medium">Réparation ou remplacement de pneu crevé à domicile — devis gratuit.</p>
    <a href="/reservation" class="bg-black text-yellow-400 font-black px-10 py-4 rounded-lg uppercase tracking-wide hover:bg-zinc-900 transition-colors inline-block">Demander une intervention</a>
  </div>
</section>

<%- include('../../partials/footer') %>
