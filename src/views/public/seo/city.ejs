<%- include('../../partials/header') %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Dépannage pneu à domicile à <%= city %>",
  "description": "Dépannage pneu crevé, montage et réparation de pneus à domicile à <%= city %> (<%= dept %>). Intervention rapide 7j/7 et 24h/24.",
  "provider": { "@type": "AutoRepair", "name": "TRANSCOM PNEUS", "url": "https://transcompneus.fr", "telephone": "<%= phone %>" },
  "areaServed": { "@type": "City", "name": "<%= city %>", "containedInPlace": { "@type": "AdministrativeArea", "name": "<%= deptName %> (<%= dept %>)" } },
  "serviceType": "Dépannage pneu à domicile"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://transcompneus.fr/" },
    { "@type": "ListItem", "position": 2, "name": "<%= deptName %> (<%= dept %>)", "item": "https://transcompneus.fr/pneus-domicile/<%= dept %>" },
    { "@type": "ListItem", "position": 3, "name": "Dépannage pneu à <%= city %>", "item": "https://transcompneus.fr/depannage-pneu/<%= currentPath.split('/').pop() %>" }
  ]
}
</script>

<section class="bg-black border-b border-zinc-800 py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <nav class="text-sm text-zinc-500 mb-6">
      <a href="/" class="hover:text-yellow-400">Accueil</a> <span class="mx-2">›</span>
      <a href="/pneus-domicile/<%= dept %>" class="hover:text-yellow-400"><%= deptName %> (<%= dept %>)</a> <span class="mx-2">›</span>
      <span class="text-zinc-300"><%= city %></span>
    </nav>
    <div class="inline-flex items-center gap-2 border border-yellow-400/40 bg-yellow-400/10 rounded-full px-4 py-1.5 text-yellow-400 text-sm font-semibold mb-6 uppercase tracking-wider">
      <span class="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></span>
      Disponible 7j/7 — 24h/24
    </div>
    <h1 class="text-3xl md:text-5xl font-black text-white uppercase mb-4">Dépannage Pneu à Domicile<br><span class="text-yellow-400">à <%= city %></span></h1>
    <p class="text-zinc-300 text-lg max-w-2xl mb-8">Vous êtes à <strong><%= city %></strong> et vous avez un pneu crevé ? TRANSCOM PNEUS intervient directement chez vous à <%= city %> (<%= dept %> – <%= deptName %>) pour la réparation, le montage ou le remplacement de vos pneus. Intervention rapide 7j/7 et 24h/24.</p>
    <div class="flex flex-wrap gap-4">
      <a href="/reservation" class="btn-primary text-base px-8 py-4">Réserver à <%= city %></a>
      <a href="tel:<%= phone %>" class="btn-secondary text-base px-8 py-4">Appeler maintenant</a>
    </div>
  </div>
</section>

<!-- Services à [Ville] -->
<section class="py-16 bg-zinc-950">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl md:text-3xl font-black text-white uppercase mb-8">Nos services à <%= city %></h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/depannage-pneu" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <span class="text-3xl mb-3 block">💥</span>
        <h3 class="font-bold text-white group-hover:text-yellow-400 mb-2">Dépannage pneu crevé</h3>
        <p class="text-zinc-400 text-sm">Pneu crevé ou à plat à <%= city %> ? Nous intervenons en urgence pour réparer ou remplacer votre pneu sur place.</p>
      </a>
      <a href="/montage-pneu-domicile" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <span class="text-3xl mb-3 block">🛞</span>
        <h3 class="font-bold text-white group-hover:text-yellow-400 mb-2">Montage de pneus</h3>
        <p class="text-zinc-400 text-sm">Montage et démontage de pneus à domicile à <%= city %> avec équilibrage inclus. Tous véhicules.</p>
      </a>
      <a href="/crevaison-voiture" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <span class="text-3xl mb-3 block">🚗</span>
        <h3 class="font-bold text-white group-hover:text-yellow-400 mb-2">Crevaison voiture</h3>
        <p class="text-zinc-400 text-sm">Réparation de crevaison voiture à <%= city %>. Diagnostic et réparation rapide sans vous déplacer.</p>
      </a>
      <a href="/crevaison-camion" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <span class="text-3xl mb-3 block">🚛</span>
        <h3 class="font-bold text-white group-hover:text-yellow-400 mb-2">Crevaison camion</h3>
        <p class="text-zinc-400 text-sm">Dépannage pneu camion et utilitaire à <%= city %>. Intervention sur site pour minimiser l'immobilisation.</p>
      </a>
      <a href="/soudure-domicile" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <span class="text-3xl mb-3 block">🔧</span>
        <h3 class="font-bold text-white group-hover:text-yellow-400 mb-2">Soudure à domicile</h3>
        <p class="text-zinc-400 text-sm">Soudure tresse, soudure acier, réparation échappement à <%= city %>. On vient avec le matériel.</p>
      </a>
      <a href="/equilibrage-roues" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <span class="text-3xl mb-3 block">⚖️</span>
        <h3 class="font-bold text-white group-hover:text-yellow-400 mb-2">Équilibrage de roues</h3>
        <p class="text-zinc-400 text-sm">Équilibrage professionnel à domicile à <%= city %> pour éliminer vibrations et usure.</p>
      </a>
    </div>
  </div>
</section>

<!-- Pourquoi nous -->
<section class="py-16 bg-black">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl font-black text-white uppercase mb-8">Pourquoi choisir TRANSCOM PNEUS à <%= city %> ?</h2>
    <div class="grid sm:grid-cols-4 gap-6 text-center">
      <div>
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-full flex items-center justify-center mx-auto mb-3 text-yellow-400 font-black text-xl">⚡</div>
        <h3 class="font-bold text-white mb-1">Rapide</h3>
        <p class="text-zinc-400 text-sm">Intervention en moins de 2h à <%= city %></p>
      </div>
      <div>
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-full flex items-center justify-center mx-auto mb-3 text-yellow-400 font-black text-xl">🏠</div>
        <h3 class="font-bold text-white mb-1">À domicile</h3>
        <p class="text-zinc-400 text-sm">On vient chez vous, pas besoin de bouger</p>
      </div>
      <div>
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-full flex items-center justify-center mx-auto mb-3 text-yellow-400 font-black text-xl">💶</div>
        <h3 class="font-bold text-white mb-1">Devis gratuit</h3>
        <p class="text-zinc-400 text-sm">Prix affichés, sans surprise ni frais cachés</p>
      </div>
      <div>
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-full flex items-center justify-center mx-auto mb-3 text-yellow-400 font-black text-xl">📅</div>
        <h3 class="font-bold text-white mb-1">7j/7 24h/24</h3>
        <p class="text-zinc-400 text-sm">Jours fériés et week-ends inclus</p>
      </div>
    </div>
  </div>
</section>

<!-- Villes proches -->
<% if (nearbyCities.length > 0) { %>
<section class="py-12 bg-zinc-950">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-xl font-bold text-white mb-6">Dépannage pneu dans les villes proches de <%= city %></h2>
    <div class="flex flex-wrap gap-2">
      <% nearbyCities.forEach(c => { %>
        <a href="/depannage-pneu/<%= c.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/['']/g,'-').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'') %>"
           class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-yellow-400 px-3 py-1.5 rounded-lg text-sm transition-colors">
          <%= c %>
        </a>
      <% }) %>
      <a href="/pneus-domicile/<%= dept %>" class="bg-yellow-400/10 hover:bg-yellow-400/20 text-yellow-400 px-3 py-1.5 rounded-lg text-sm transition-colors font-semibold">
        Tout le <%= dept %> →
      </a>
    </div>
  </div>
</section>
<% } %>

<!-- CTA -->
<section class="py-20 bg-yellow-400">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl font-black text-black uppercase mb-4">Pneu crevé à <%= city %> ?</h2>
    <p class="text-black/70 text-lg mb-8 font-medium">Dépannage pneu à domicile à <%= city %> — devis gratuit, intervention rapide.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/reservation" class="bg-black text-yellow-400 font-black px-10 py-4 rounded-lg uppercase tracking-wide hover:bg-zinc-900 transition-colors">Réserver un dépannage</a>
      <a href="tel:<%= phone %>" class="bg-black/20 text-black font-bold px-10 py-4 rounded-lg uppercase tracking-wide hover:bg-black/30 transition-colors border-2 border-black/30">Appeler</a>
    </div>
  </div>
</section>

<%- include('../../partials/footer') %>
