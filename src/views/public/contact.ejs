<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 pb-24">
  <div class="text-center mb-10">
    <h1 class="text-3xl md:text-4xl font-extrabold mb-3">Contact</h1>
    <p class="text-gray-400">Une question ? Nous répondons sous 24h.</p>
  </div>

  <div class="grid lg:grid-cols-2 gap-8">
    <!-- Infos contact -->
    <div class="space-y-6">
      <div class="card p-6">
        <h2 class="font-bold text-lg mb-4">Nous contacter directement</h2>
        <div class="space-y-4">
          <a href="tel:<%= phone %>" class="flex items-center gap-3 text-red-400 hover:text-red-300 transition-colors">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span class="font-semibold"><%= phone %></span>
          </a>
          <a href="https://wa.me/<%= whatsapp.replace(/\D/g,'') %>" target="_blank" class="flex items-center gap-3 text-green-400 hover:text-green-300 transition-colors">
            <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            <span class="font-semibold">WhatsApp</span>
          </a>
          <% if (settings.company_email) { %>
            <a href="mailto:<%= settings.company_email %>" class="flex items-center gap-3 text-gray-300 hover:text-white transition-colors">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <%= settings.company_email %>
            </a>
          <% } %>
        </div>
      </div>
      <% if (settings.opening_hours) { %>
        <div class="card p-6">
          <h3 class="font-bold mb-2">Horaires</h3>
          <p class="text-gray-300"><%= settings.opening_hours %></p>
        </div>
      <% } %>
      <div class="card p-6">
        <h3 class="font-bold mb-2">Zone d'intervention</h3>
        <p class="text-gray-300">Paris et toute l'Île-de-France :<br>75, 77, 78, 91, 92, 93, 94, 95</p>
      </div>
    </div>

    <!-- Formulaire -->
    <div class="card p-6">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-green-900/50 border border-green-700 text-green-300 rounded-lg p-4 mb-5 flex items-center gap-2">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <%= success %>
        </div>
      <% } %>
      <h2 class="font-bold text-lg mb-5">Envoyer un message</h2>
      <form method="POST" action="/contact" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (errors && errors.length > 0) { %>
          <div class="bg-red-900/50 border border-red-700 rounded-lg p-3 text-red-300 text-sm">
            <% errors.forEach(e => { %><p>• <%= e.message %></p><% }) %>
          </div>
        <% } %>
        <div>
          <label class="form-label">Nom *</label>
          <input class="form-input" type="text" name="name" value="<%= formData.name || '' %>" required>
        </div>
        <div>
          <label class="form-label">Email *</label>
          <input class="form-input" type="email" name="email" value="<%= formData.email || '' %>" required>
        </div>
        <div>
          <label class="form-label">Téléphone</label>
          <input class="form-input" type="tel" name="phone" value="<%= formData.phone || '' %>">
        </div>
        <div>
          <label class="form-label">Message *</label>
          <textarea class="form-input" name="message" rows="5" required><%= formData.message || '' %></textarea>
        </div>
        <button type="submit" class="btn-primary w-full justify-center">Envoyer</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
