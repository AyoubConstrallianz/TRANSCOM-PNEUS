<%- include('../partials/header') %>

<!-- ─── HERO ──────────────────────────────────────────────────────────────────── -->
<section class="relative bg-black overflow-hidden min-h-[85vh] flex items-center justify-center">
  <!-- Fond rayé diagonal subtil -->
  <div class="absolute inset-0 opacity-5" style="background-image:repeating-linear-gradient(-45deg,#F5C200 0,#F5C200 1px,transparent 0,transparent 50%);background-size:8px 8px;"></div>

  <div class="relative w-full px-4 sm:px-6 py-20 text-center">

    <!-- Badge -->
    <div class="inline-flex items-center gap-2 border border-yellow-400/40 bg-yellow-400/10 rounded-full px-4 py-1.5 text-yellow-400 text-sm font-semibold mb-8 uppercase tracking-wider">
      <span class="w-2 h-2 bg-yellow-400 rounded-full animate-pulse"></span>
      Intervention à domicile — 7j/7 & 24h/24
    </div>

    <!-- Titre -->
    <h1 class="uppercase leading-none mb-8" style="font-family: 'Fugaz One', sans-serif; font-size: clamp(4rem, 15vw, 14rem); line-height: 0.9;">
      <span class="block text-white">TRANSCOM</span>
      <span class="block text-yellow-400">PNEUS</span>
    </h1>

    <p class="text-xl md:text-2xl text-zinc-300 font-medium mb-3 max-w-2xl mx-auto">
      <%= settings.hero_subtitle || 'Montage, réparation, équilibrage — on se déplace chez vous.' %>
    </p>
    <p class="text-zinc-500 mb-10">Paris · 77 · 78 · 91 · 92 · 93 · 94 · 95</p>

    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/reservation" class="btn-primary text-base px-8 py-4">Prendre rendez-vous</a>
      <a href="/services" class="btn-secondary text-base px-8 py-4">Nos services</a>
      <a href="tel:<%= phone %>" class="btn-outline text-base px-8 py-4">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Appeler maintenant
      </a>
    </div>
  </div>
</section>

<!-- ─── Bandeau services rapides ─────────────────────────────────────────────── -->
<div class="bg-yellow-400 text-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
    <div class="flex flex-wrap justify-center gap-6 md:gap-10 text-sm font-bold uppercase tracking-wide">
      <span class="flex items-center gap-2">🔧 Réparation de pneus</span>
      <span class="text-black/30 hidden sm:inline">|</span>
      <span class="flex items-center gap-2">🛞 Changement de pneus</span>
      <span class="text-black/30 hidden sm:inline">|</span>
      <span class="flex items-center gap-2">⚡ Intervention rapide 24h/24</span>
      <span class="text-black/30 hidden sm:inline">|</span>
      <span class="flex items-center gap-2">🏠 À domicile</span>
    </div>
  </div>
</div>

<!-- ─── Avantages ─────────────────────────────────────────────────────────────── -->
<section class="py-16 bg-zinc-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-3 gap-6">

      <div class="card p-6 flex gap-4 items-start group hover:border-yellow-400/50 transition-colors">
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-yellow-400/20 transition-colors">
          <svg class="w-7 h-7 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <h3 class="font-bold text-white mb-1">Déplacement à domicile</h3>
          <p class="text-zinc-400 text-sm">Partout en Île-de-France (75, 77, 78, 91, 92, 93, 94, 95). Aucun déplacement de votre part.</p>
        </div>
      </div>

      <div class="card p-6 flex gap-4 items-start group hover:border-yellow-400/50 transition-colors">
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-yellow-400/20 transition-colors">
          <svg class="w-7 h-7 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div>
          <h3 class="font-bold text-white mb-1">Intervention rapide</h3>
          <p class="text-zinc-400 text-sm">Disponibles 7j/7 et 24h/24. Dépannage urgent en moins de 2h. Créneaux le jour même.</p>
        </div>
      </div>

      <div class="card p-6 flex gap-4 items-start group hover:border-yellow-400/50 transition-colors">
        <div class="w-14 h-14 bg-yellow-400/10 border border-yellow-400/30 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-yellow-400/20 transition-colors">
          <svg class="w-7 h-7 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h3 class="font-bold text-white mb-1">Prix transparents</h3>
          <p class="text-zinc-400 text-sm">Devis gratuit. Frais de déplacement affichés avant validation. Zéro surprise.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── Services ──────────────────────────────────────────────────────────────── -->
<section class="py-16 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-yellow-400 font-bold uppercase tracking-widest text-sm mb-2">Ce qu'on fait</p>
        <h2 class="text-3xl md:text-4xl font-black text-white uppercase">Nos prestations</h2>
      </div>
      <a href="/services" class="btn-outline py-2 px-4 hidden sm:inline-flex">Tout voir →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% services.forEach((s, i) => { %>
        <div class="card p-5 hover:border-yellow-400/50 transition-colors group">
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors"><%= s.name %></h3>
            <span class="text-yellow-400 font-semibold text-sm flex-shrink-0 ml-2"><%= s.priceLabel || 'Prix sur devis' %></span>
          </div>
          <% if (s.description) { %><p class="text-zinc-400 text-sm leading-relaxed"><%= s.description %></p><% } %>
          <div class="flex items-center justify-between mt-4 pt-3 border-t border-zinc-800">
            <span class="text-zinc-600 text-xs uppercase tracking-wide"><%= s.category || '' %></span>
            <a href="/reservation?serviceId=<%= s.id %>" class="text-xs text-yellow-400 hover:text-yellow-300 font-semibold">Réserver →</a>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<%# CATALOGUE DÉSACTIVÉ TEMPORAIREMENT %>

<!-- ─── Pages de service SEO ────────────────────────────────────────────────── -->
<section class="py-16 bg-zinc-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <p class="text-yellow-400 font-bold uppercase tracking-widest text-sm mb-2">Interventions spécialisées</p>
      <h2 class="text-3xl md:text-4xl font-black text-white uppercase">Nos spécialités</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <a href="/depannage-pneu" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors mb-2">Dépannage pneu à domicile</h3>
        <p class="text-zinc-400 text-sm">Pneu crevé, pneu à plat, éclatement — intervention d'urgence 7j/7 et 24h/24 en Île-de-France.</p>
      </a>
      <a href="/crevaison-voiture" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors mb-2">Crevaison voiture</h3>
        <p class="text-zinc-400 text-sm">Réparation ou remplacement de pneu crevé sur votre voiture, directement à votre adresse.</p>
      </a>
      <a href="/crevaison-camion" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors mb-2">Crevaison camion & utilitaire</h3>
        <p class="text-zinc-400 text-sm">Dépannage pneu camion, fourgon et utilitaire sur site. Contrats flottes disponibles.</p>
      </a>
      <a href="/soudure-domicile" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors mb-2">Soudure à domicile</h3>
        <p class="text-zinc-400 text-sm">Soudure tresse voiture, soudure acier, réparation échappement et pièces métalliques.</p>
      </a>
      <a href="/montage-pneu-domicile" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors mb-2">Montage pneu à domicile</h3>
        <p class="text-zinc-400 text-sm">Montage et démontage de pneus chez vous avec équilibrage inclus. Tous véhicules.</p>
      </a>
      <a href="/equilibrage-roues" class="card p-5 hover:border-yellow-400/50 transition-colors group block">
        <h3 class="font-bold text-white group-hover:text-yellow-400 transition-colors mb-2">Équilibrage de roues</h3>
        <p class="text-zinc-400 text-sm">Vibrations au volant ? Équilibrage professionnel à domicile avec équilibreuse mobile.</p>
      </a>
    </div>
  </div>
</section>

<!-- ─── Zones ──────────────────────────────────────────────────────────────────── -->
<section class="py-16 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <p class="text-yellow-400 font-bold uppercase tracking-widest text-sm mb-2">Partout en IDF</p>
      <h2 class="text-3xl md:text-4xl font-black text-white uppercase">Zones d'intervention</h2>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <% Object.entries(depts).forEach(([code, name]) => { %>
        <a href="/pneus-domicile/<%= code %>" class="card p-4 text-center hover:border-yellow-400/60 hover:bg-yellow-400/5 transition-all group">
          <span class="text-2xl font-black text-yellow-400 group-hover:scale-110 inline-block transition-transform"><%= code %></span>
          <p class="text-zinc-400 text-sm mt-1 group-hover:text-white transition-colors"><%= name %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ─── Avis clients ───────────────────────────────────────────────────────────── -->
<% if (reviews.length > 0) { %>
<section class="py-16 bg-zinc-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <p class="text-yellow-400 font-bold uppercase tracking-widest text-sm mb-2">Ils nous font confiance</p>
      <h2 class="text-3xl md:text-4xl font-black text-white uppercase">Avis clients</h2>
      <div class="flex justify-center items-center gap-1 text-yellow-400 mt-3 text-xl">
        ★★★★★ <span class="text-zinc-500 text-sm ml-2 font-normal"><%= reviews.length %> avis vérifiés</span>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% reviews.forEach(r => { %>
        <div class="card p-6 hover:border-yellow-400/30 transition-colors">
          <div class="flex items-center gap-0.5 text-yellow-400 mb-3 text-lg">
            <% for(let i=0;i<r.rating;i++) { %><span>★</span><% } %>
          </div>
          <p class="text-zinc-300 text-sm leading-relaxed italic mb-4">"<%= r.comment %>"</p>
          <p class="text-zinc-500 text-sm font-semibold">— <%= r.name %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ─── CTA final ─────────────────────────────────────────────────────────────── -->
<section class="py-20 bg-yellow-400">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-black text-black uppercase mb-4">Besoin d'un pneu ?</h2>
    <p class="text-black/70 text-lg mb-8 font-medium">Réservez en 2 minutes — on vient chez vous.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/reservation" class="bg-black text-yellow-400 font-black px-10 py-4 rounded-lg uppercase tracking-wide hover:bg-zinc-900 transition-colors inline-flex items-center gap-2">
        Prendre rendez-vous
      </a>
      <a href="tel:<%= phone %>" class="bg-black/20 text-black font-bold px-10 py-4 rounded-lg uppercase tracking-wide hover:bg-black/30 transition-colors border-2 border-black/30 inline-flex items-center gap-2">
        📞 Appeler
      </a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
