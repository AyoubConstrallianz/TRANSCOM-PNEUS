<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 pb-32 text-center">
  <div class="w-20 h-20 bg-green-900/50 rounded-full flex items-center justify-center mx-auto mb-6">
    <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>
  </div>
  <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Demande envoyée !</h1>
  <% if (bookingId) { %>
    <p class="text-gray-400 mb-2">Réservation <strong class="text-white">#<%= bookingId %></strong></p>
  <% } %>
  <p class="text-gray-300 text-lg leading-relaxed mb-8">
    Merci pour votre réservation. Vous allez recevoir un email de confirmation.
    Notre équipe vous contactera dans les 30 minutes pour valider le créneau.
  </p>
  <div class="bg-gray-800 rounded-xl p-6 mb-8 text-left space-y-2">
    <p class="text-sm text-gray-400">En cas d'urgence, appelez-nous directement :</p>
    <a href="tel:<%= phone %>" class="flex items-center gap-2 text-red-400 hover:text-red-300 font-bold text-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
      <%= phone %>
    </a>
  </div>
  <div class="flex flex-col sm:flex-row gap-4 justify-center">
    <a href="/" class="btn-outline px-8 py-3">Retour à l'accueil</a>
    <a href="/catalogue" class="btn-primary px-8 py-3">Voir le catalogue</a>
  </div>
</div>

<%- include('../partials/footer') %>
