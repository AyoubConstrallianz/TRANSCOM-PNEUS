<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex">

  <!-- Sidebar -->
  <aside class="w-64 bg-gray-800 flex-shrink-0 flex flex-col min-h-screen shadow-xl hidden lg:flex">
    <div class="p-5 border-b border-gray-700">
      <h1 class="font-bold text-lg text-white">TRANSCOM <span class="text-red-500">PNEUS</span></h1>
      <p class="text-xs text-gray-500 mt-0.5">Administration</p>
    </div>
    <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
      <a href="/admin" class="admin-sidebar-link <%= currentPath === '/admin' ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Tableau de bord
      </a>
      <a href="/admin/bookings" class="admin-sidebar-link <%= currentPath.startsWith('/admin/bookings') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Réservations
      </a>
      <a href="/admin/tires" class="admin-sidebar-link <%= currentPath.startsWith('/admin/tires') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
        Pneus
      </a>
      <a href="/admin/tires/pricing" class="admin-sidebar-link <%= currentPath === '/admin/tires/pricing' ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Prix en masse
      </a>
      <a href="/admin/services" class="admin-sidebar-link <%= currentPath.startsWith('/admin/services') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Services
      </a>
      <a href="/admin/zones" class="admin-sidebar-link <%= currentPath.startsWith('/admin/zones') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Zones & frais
      </a>
      <a href="/admin/customers" class="admin-sidebar-link <%= currentPath.startsWith('/admin/customers') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Clients
      </a>
      <a href="/admin/settings" class="admin-sidebar-link <%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Paramètres
      </a>
    </nav>
    <div class="p-4 border-t border-gray-700">
      <p class="text-xs text-gray-500 mb-2">Connecté : <span class="text-gray-300"><%= typeof userName !== 'undefined' ? userName : req?.session?.userName || 'Admin' %></span></p>
      <form method="POST" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="text-xs text-gray-400 hover:text-red-400 transition-colors">Déconnexion</button>
      </form>
    </div>
  </aside>

  <!-- Main content -->
  <main class="flex-1 flex flex-col min-h-screen overflow-auto">
    <!-- Mobile header -->
    <header class="lg:hidden bg-gray-800 p-4 flex items-center justify-between sticky top-0 z-30 shadow">
      <h1 class="font-bold text-white">TRANSCOM <span class="text-red-500">PNEUS</span></h1>
      <button id="menu-btn" class="text-gray-300 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </header>

    <div class="flex-1 p-4 md:p-6 lg:p-8">
      <!-- Notifications flash -->
      <% if (success) { %>
        <div class="bg-green-900/50 border border-green-700 text-green-300 rounded-lg px-4 py-3 mb-6">
          <svg class="inline w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <%= success %>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="bg-red-900/50 border border-red-700 text-red-300 rounded-lg px-4 py-3 mb-6">
          <%= error %>
        </div>
      <% } %>

      <%- body %>
    </div>
  </main>

  <script>
    const btn = document.getElementById('menu-btn');
    const sidebar = document.querySelector('aside');
    if (btn && sidebar) {
      btn.addEventListener('click', () => sidebar.classList.toggle('hidden'));
    }
  </script>
</body>
</html>
