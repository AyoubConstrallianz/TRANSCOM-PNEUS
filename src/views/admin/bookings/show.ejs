<%- include('../../partials/admin-head') %>

<div class="flex items-center gap-3 mb-6">
  <a href="/admin/bookings" class="text-gray-400 hover:text-white">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
  </a>
  <h2 class="text-2xl font-bold">Réservation #<%= booking.id %></h2>
  <span class="badge-<%= booking.status === 'new' ? 'new' : booking.status === 'confirmed' ? 'confirm' : booking.status === 'in_progress' ? 'progress' : booking.status === 'done' ? 'done' : 'cancel' %>">
    <%= STATUS_LABELS[booking.status] %>
  </span>
</div>

<div class="grid lg:grid-cols-3 gap-6">
  <!-- Infos principale -->
  <div class="lg:col-span-2 space-y-6">
    <div class="card p-6">
      <h3 class="font-semibold mb-4 text-gray-300 text-sm uppercase tracking-wide">Détails de la réservation</h3>
      <dl class="grid sm:grid-cols-2 gap-4">
        <div><dt class="text-gray-500 text-sm">Date</dt><dd class="font-medium"><%= new Date(booking.date).toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></dd></div>
        <div><dt class="text-gray-500 text-sm">Créneau</dt><dd class="font-medium"><%= booking.slot %>h</dd></div>
        <div><dt class="text-gray-500 text-sm">Adresse</dt><dd class="font-medium"><%= booking.address %>, <%= booking.postalCode %></dd></div>
        <div><dt class="text-gray-500 text-sm">Département</dt><dd class="font-medium"><%= booking.zone?.name || booking.postalCode.substring(0,2) %></dd></div>
        <% if (booking.plate) { %><div><dt class="text-gray-500 text-sm">Immatriculation</dt><dd class="font-mono font-medium"><%= booking.plate %></dd></div><% } %>
        <div><dt class="text-gray-500 text-sm">Service</dt><dd class="font-medium"><%= booking.service?.name || '—' %></dd></div>
        <% if (booking.tire) { %>
          <div><dt class="text-gray-500 text-sm">Pneu</dt><dd class="font-medium"><%= booking.tire.brand %> <%= booking.tire.model %> <%= booking.tire.width %>/<%= booking.tire.ratio %> R<%= booking.tire.diameter %></dd></div>
          <div><dt class="text-gray-500 text-sm">Quantité</dt><dd class="font-medium"><%= booking.tireQty %> pneu(s)</dd></div>
        <% } %>
        <div><dt class="text-gray-500 text-sm">Frais déplacement</dt><dd class="font-medium"><%= booking.travelFee.toFixed(2) %> €</dd></div>
        <div><dt class="text-gray-500 text-sm">Total</dt><dd class="font-semibold text-orange-400 text-lg"><%= booking.totalPrice.toFixed(2) %> €</dd></div>
      </dl>
    </div>

    <!-- Client -->
    <div class="card p-6">
      <h3 class="font-semibold mb-4 text-gray-300 text-sm uppercase tracking-wide">Client</h3>
      <dl class="grid sm:grid-cols-2 gap-4">
        <div>
          <dt class="text-gray-500 text-sm">Type</dt>
          <dd class="font-medium">
            <% if (booking.clientType === 'professionnel') { %>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-400/10 text-blue-400 border border-blue-400/30">🏢 Professionnel</span>
            <% } else { %>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-zinc-700 text-zinc-300 border border-zinc-600">🏠 Particulier</span>
            <% } %>
          </dd>
        </div>
        <div><dt class="text-gray-500 text-sm">Nom</dt><dd class="font-medium"><%= booking.customer.name %></dd></div>
        <div><dt class="text-gray-500 text-sm">Téléphone</dt><dd><a href="tel:<%= booking.customer.phone %>" class="text-yellow-400 hover:text-yellow-300 font-medium"><%= booking.customer.phone %></a></dd></div>
        <% if (booking.customer.email) { %><div><dt class="text-gray-500 text-sm">Email</dt><dd><a href="mailto:<%= booking.customer.email %>" class="text-yellow-400 hover:text-yellow-300 font-medium"><%= booking.customer.email %></a></dd></div><% } %>
      </dl>
      <a href="/admin/customers/<%= booking.customer.id %>" class="inline-block mt-3 text-xs text-blue-400 hover:text-blue-300">Voir fiche client →</a>
    </div>

    <!-- Notes -->
    <div class="card p-6">
      <h3 class="font-semibold mb-4 text-gray-300 text-sm uppercase tracking-wide">Notes internes</h3>
      <form method="POST" action="/admin/bookings/<%= booking.id %>/notes">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <textarea class="form-input mb-3" name="notes" rows="4" placeholder="Notes internes visibles uniquement par l'admin..."><%= booking.notes || '' %></textarea>
        <button type="submit" class="btn-primary text-sm py-2 px-4">Sauvegarder les notes</button>
      </form>
    </div>
  </div>

  <!-- Actions -->
  <div class="space-y-4">
    <div class="card p-6">
      <h3 class="font-semibold mb-4 text-gray-300 text-sm uppercase tracking-wide">Changer le statut</h3>
      <form method="POST" action="/admin/bookings/<%= booking.id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="status" class="form-select mb-3">
          <% Object.entries(STATUS_LABELS).forEach(([k,v]) => { %>
            <option value="<%= k %>" <%= booking.status === k ? 'selected' : '' %>><%= v %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn-primary w-full justify-center text-sm py-2">Mettre à jour</button>
      </form>
    </div>

    <div class="card p-6">
      <h3 class="font-semibold mb-4 text-gray-300 text-sm uppercase tracking-wide">Informations</h3>
      <p class="text-gray-400 text-xs">Créée le <%= new Date(booking.createdAt).toLocaleDateString('fr-FR') %> à <%= new Date(booking.createdAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></p>
    </div>

    <div class="card p-6">
      <form method="POST" action="/admin/bookings/<%= booking.id %>/delete" onsubmit="return confirm('Supprimer définitivement cette réservation ?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="w-full text-sm text-red-400 hover:text-red-300 transition-colors">Supprimer la réservation</button>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/admin-foot') %>
