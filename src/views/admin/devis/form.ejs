<%- include('../../partials/admin-head') %>

<div class="flex items-center gap-3 mb-6">
  <a href="/admin/devis" class="text-zinc-400 hover:text-white">← Devis</a>
  <h1 class="text-2xl font-bold text-white">Nouveau devis</h1>
</div>

<% if (error) { %>
  <div class="bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-3 rounded-lg mb-6"><%= error %></div>
<% } %>

<form action="/admin/devis" method="POST" id="devis-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="items" id="items-json" value="[]">

  <div class="grid md:grid-cols-2 gap-6">

    <!-- Infos client -->
    <div class="card p-6">
      <h2 class="text-lg font-semibold text-yellow-400 mb-4">Informations client</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Nom complet *</label>
          <input type="text" name="clientName" required class="input w-full" placeholder="Jean Dupont">
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Email *</label>
          <input type="email" name="clientEmail" required class="input w-full" placeholder="jean@example.com">
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Téléphone</label>
          <input type="tel" name="clientPhone" class="input w-full" placeholder="+33 6 XX XX XX XX">
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Type de client</label>
          <select name="clientType" class="input w-full" style="color: white;">
            <option value="particulier" style="background:#18181b;color:white;">🏠 Particulier</option>
            <option value="professionnel" style="background:#18181b;color:white;">🏢 Professionnel</option>
          </select>
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Adresse d'intervention</label>
          <input type="text" name="clientAddress" class="input w-full" placeholder="12 rue de la Paix, 75001 Paris">
        </div>
      </div>
    </div>

    <!-- Validité & notes -->
    <div class="card p-6">
      <h2 class="text-lg font-semibold text-yellow-400 mb-4">Paramètres du devis</h2>
      <div class="space-y-4">
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Valable jusqu'au</label>
          <input type="date" name="validUntil" class="input w-full"
            value="<%= new Date(Date.now() + 30*24*60*60*1000).toISOString().slice(0,10) %>">
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Frais de déplacement (€)</label>
          <input type="number" name="travelFee" id="travel-fee" class="input w-full" value="0" min="0" step="0.01">
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-1">Notes / Commentaires</label>
          <textarea name="notes" class="input w-full h-28 resize-none" placeholder="Conditions particulières, précisions..."></textarea>
        </div>
      </div>
    </div>
  </div>

  <!-- Lignes de prestations -->
  <div class="card p-6 mt-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-yellow-400">Prestations</h2>
      <button type="button" onclick="addLine()" class="btn-secondary text-sm">+ Ajouter une ligne</button>
    </div>

    <table class="w-full text-sm" id="lines-table">
      <thead>
        <tr class="text-zinc-400 text-xs uppercase border-b border-zinc-800">
          <th class="pb-2 text-left">Description</th>
          <th class="pb-2 text-center w-20">Qté</th>
          <th class="pb-2 text-right w-32">Prix unit. (€)</th>
          <th class="pb-2 text-right w-32">Total</th>
          <th class="pb-2 w-10"></th>
        </tr>
      </thead>
      <tbody id="lines-body"></tbody>
    </table>

    <div class="mt-4 flex flex-col items-end gap-1 text-sm">
      <div class="flex gap-8 text-zinc-400">
        <span>Frais de déplacement</span>
        <span id="display-travel" class="text-white">0,00 €</span>
      </div>
      <div class="flex gap-8 text-lg font-bold">
        <span class="text-yellow-400">TOTAL TTC</span>
        <span class="text-white" id="display-total">0,00 €</span>
      </div>
    </div>
  </div>

  <div class="mt-6 flex gap-4">
    <button type="submit" class="btn-primary px-8">Créer le devis</button>
    <a href="/admin/devis" class="btn-secondary px-8">Annuler</a>
  </div>
</form>

<script>
let lines = [];

function addLine(desc = '', qty = 1, price = 0) {
  const id = Date.now();
  lines.push({ id, description: desc, qty, unitPrice: price });
  renderLines();
}

function removeLine(id) {
  lines = lines.filter(l => l.id !== id);
  renderLines();
}

function updateLine(id, field, value) {
  const l = lines.find(l => l.id === id);
  if (l) {
    l[field] = field === 'qty' ? parseInt(value) || 1 : field === 'unitPrice' ? parseFloat(value) || 0 : value;
  }
  renderTotals();
  syncJson();
}

function renderLines() {
  const tbody = document.getElementById('lines-body');
  tbody.innerHTML = lines.map(l => `
    <tr class="border-b border-zinc-800/50" data-id="${l.id}">
      <td class="py-2 pr-3">
        <input type="text" value="${l.description}" onchange="updateLine(${l.id},'description',this.value)"
          class="input w-full text-sm" placeholder="Ex: Montage 4 pneus">
      </td>
      <td class="py-2 px-2">
        <input type="number" value="${l.qty}" min="1" onchange="updateLine(${l.id},'qty',this.value)"
          class="input w-full text-center text-sm">
      </td>
      <td class="py-2 px-2">
        <input type="number" value="${l.unitPrice}" min="0" step="0.01" onchange="updateLine(${l.id},'unitPrice',this.value)"
          class="input w-full text-right text-sm">
      </td>
      <td class="py-2 pl-2 text-right font-semibold text-white" id="line-total-${l.id}">
        ${(l.qty * l.unitPrice).toFixed(2)} €
      </td>
      <td class="py-2 pl-2 text-center">
        <button type="button" onclick="removeLine(${l.id})" class="text-red-400 hover:text-red-300 text-lg leading-none">×</button>
      </td>
    </tr>`).join('');
  renderTotals();
  syncJson();
}

function renderTotals() {
  const subtotal = lines.reduce((s, l) => s + l.qty * l.unitPrice, 0);
  const travel   = parseFloat(document.getElementById('travel-fee').value) || 0;
  const total    = subtotal + travel;
  document.getElementById('display-travel').textContent = travel.toFixed(2).replace('.', ',') + ' €';
  document.getElementById('display-total').textContent  = total.toFixed(2).replace('.', ',') + ' €';
  lines.forEach(l => {
    const el = document.getElementById('line-total-' + l.id);
    if (el) el.textContent = (l.qty * l.unitPrice).toFixed(2) + ' €';
  });
}

function syncJson() {
  document.getElementById('items-json').value = JSON.stringify(
    lines.map(({ description, qty, unitPrice }) => ({ description, qty, unitPrice }))
  );
}

document.getElementById('travel-fee').addEventListener('input', renderTotals);
document.getElementById('devis-form').addEventListener('submit', syncJson);

// Ligne par défaut
addLine('', 1, 0);
</script>

<%- include('../../partials/admin-foot') %>
