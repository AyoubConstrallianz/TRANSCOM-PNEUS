<%- include('../../partials/admin-head') %>

<div class="max-w-lg">
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/services" class="text-gray-400 hover:text-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h2 class="text-2xl font-bold"><%= title %></h2>
  </div>

  <% if (errors) { %>
    <div class="bg-red-900/50 border border-red-700 rounded-lg p-4 mb-6">
      <ul class="list-disc list-inside text-red-300 text-sm space-y-1">
        <% errors.forEach(e => { %><li><%= e.message %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= service?.id ? '/admin/services/' + service.id : '/admin/services' %>" class="card p-6 space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label class="form-label">Catégorie</label>
      <select class="form-select" name="category">
        <% const cats = ['Montage de pneu à domicile','Soudure','Achat-vente','Général']; %>
        <% cats.forEach(c => { %>
          <option value="<%= c %>" <%= (service?.category || 'Général') === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="form-label">Nom du service *</label>
      <input class="form-input" type="text" name="name" value="<%= service?.name || '' %>" required>
    </div>
    <div>
      <label class="form-label">Description</label>
      <textarea class="form-input" name="description" rows="3"><%= service?.description || '' %></textarea>
    </div>
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label">Libellé prix (affiché)</label>
        <input class="form-input" type="text" name="priceLabel" value="<%= service?.priceLabel || 'Prix sur devis' %>" placeholder="Ex: Prix sur devis, À partir de 30€">
      </div>
      <div>
        <label class="form-label">Durée (min) *</label>
        <input class="form-input" type="number" name="duration" value="<%= service?.duration || 30 %>" required>
      </div>
    </div>
    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="active" class="w-4 h-4 rounded" <%= !service || service.active !== false ? 'checked' : '' %>>
      <span class="text-sm text-gray-300">Service actif</span>
    </label>
    <div class="flex gap-3">
      <button type="submit" class="btn-primary"><%= service?.id ? 'Enregistrer' : 'Créer' %></button>
      <a href="/admin/services" class="btn-outline">Annuler</a>
    </div>
  </form>
</div>

<%- include('../../partials/admin-foot') %>
