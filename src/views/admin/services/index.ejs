<%- include('../../partials/admin-head') %>

<div class="flex items-center justify-between mb-6">
  <h2 class="text-2xl font-bold">Services</h2>
  <a href="/admin/services/new" class="btn-primary text-sm py-2 px-4">+ Nouveau service</a>
</div>

<%
  const grouped = {};
  services.forEach(s => {
    const cat = s.category || 'Général';
    if (!grouped[cat]) grouped[cat] = [];
    grouped[cat].push(s);
  });
%>

<% Object.entries(grouped).forEach(([cat, items]) => { %>
<div class="mb-10">
  <h3 class="text-sm font-bold uppercase tracking-widest text-yellow-400 mb-4 border-b border-zinc-800 pb-2"><%= cat %></h3>
  <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
    <% items.forEach(s => { %>
      <div class="card p-5 flex flex-col gap-3 <%= !s.active ? 'opacity-50' : '' %>">
        <div class="flex items-start justify-between gap-2">
          <h4 class="font-semibold text-white"><%= s.name %></h4>
          <span class="text-yellow-400 font-semibold text-sm whitespace-nowrap"><%= s.priceLabel || 'Prix sur devis' %></span>
        </div>
        <% if (s.description) { %><p class="text-zinc-400 text-sm flex-1"><%= s.description %></p><% } %>
        <p class="text-zinc-500 text-xs">Durée : <%= s.duration %> min | <%- s.active ? '<span class="text-green-400">Actif</span>' : '<span class="text-red-400">Inactif</span>' %></p>
        <div class="flex gap-2 mt-auto pt-2 border-t border-zinc-800">
          <a href="/admin/services/<%= s.id %>/edit" class="flex-1 text-center text-xs bg-zinc-800 hover:bg-zinc-700 text-white py-1.5 rounded transition-colors">Modifier</a>
          <form method="POST" action="/admin/services/<%= s.id %>/delete" onsubmit="return confirm('Supprimer ce service ?')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="text-xs text-red-400 hover:text-red-300 px-3 py-1.5 transition-colors">Supprimer</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<% }) %>

<%- include('../../partials/admin-foot') %>
