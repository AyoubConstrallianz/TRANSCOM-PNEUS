<% const adminName = userName; %>
<%- include('../partials/admin-head') %>

<div class="mb-6">
  <h2 class="text-2xl font-bold">Tableau de bord</h2>
  <p class="text-gray-400 text-sm mt-1"><%= new Date().toLocaleDateString('fr-FR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="card p-5">
    <p class="text-gray-400 text-sm">Réservations aujourd'hui</p>
    <p class="text-3xl font-bold text-white mt-1"><%= todayBookings.length %></p>
  </div>
  <div class="card p-5">
    <p class="text-gray-400 text-sm">Total réservations</p>
    <p class="text-3xl font-bold text-white mt-1"><%= totalBookings %></p>
  </div>
  <div class="card p-5">
    <p class="text-gray-400 text-sm">CA ce mois</p>
    <p class="text-3xl font-bold text-orange-400 mt-1"><%= monthRevenue.toFixed(0) %> €</p>
  </div>
  <div class="card p-5">
    <p class="text-gray-400 text-sm">CA total</p>
    <p class="text-3xl font-bold text-green-400 mt-1"><%= totalRevenue.toFixed(0) %> €</p>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-6">
  <!-- Réservations du jour -->
  <div class="card">
    <div class="p-5 border-b border-gray-700 flex items-center justify-between">
      <h3 class="font-semibold">Réservations du jour</h3>
      <a href="/admin/bookings" class="text-red-400 hover:text-red-300 text-sm">Toutes →</a>
    </div>
    <div class="divide-y divide-gray-700">
      <% if (todayBookings.length === 0) { %>
        <p class="p-5 text-gray-500 text-sm">Aucune réservation aujourd'hui.</p>
      <% } else { %>
        <% todayBookings.forEach(b => { %>
          <a href="/admin/bookings/<%= b.id %>" class="flex items-center gap-3 p-4 hover:bg-gray-700/50 transition-colors">
            <div class="w-10 h-10 bg-red-900/50 rounded-full flex items-center justify-center flex-shrink-0 font-bold text-red-400"><%= b.slot %></div>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-sm truncate"><%= b.customer.name %></p>
              <p class="text-gray-400 text-xs"><%= b.service?.name || 'Service N/A' %></p>
            </div>
            <span class="badge-<%= b.status === 'new' ? 'new' : b.status === 'confirmed' ? 'confirm' : b.status === 'in_progress' ? 'progress' : b.status === 'done' ? 'done' : 'cancel' %>">
              <%= b.status === 'new' ? 'Nouveau' : b.status === 'confirmed' ? 'Confirmé' : b.status === 'in_progress' ? 'En cours' : b.status === 'done' ? 'Terminé' : 'Annulé' %>
            </span>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Stocks bas -->
  <div class="card">
    <div class="p-5 border-b border-gray-700 flex items-center justify-between">
      <h3 class="font-semibold">Stocks bas <span class="text-gray-500 text-sm font-normal">(≤ 3)</span></h3>
      <a href="/admin/tires?lowstock=1" class="text-red-400 hover:text-red-300 text-sm">Voir tout →</a>
    </div>
    <div class="divide-y divide-gray-700">
      <% if (lowStock.length === 0) { %>
        <p class="p-5 text-gray-500 text-sm">Tous les stocks sont suffisants.</p>
      <% } else { %>
        <% lowStock.forEach(t => { %>
          <a href="/admin/tires/<%= t.id %>/edit" class="flex items-center justify-between p-4 hover:bg-gray-700/50 transition-colors">
            <div>
              <p class="font-medium text-sm"><%= t.brand %> <%= t.model %></p>
              <p class="text-gray-400 text-xs"><%= t.width %>/<%= t.ratio %> R<%= t.diameter %></p>
            </div>
            <span class="<%= t.stock === 0 ? 'badge-cancel' : 'badge-new' %>"><%= t.stock %> restant(s)</span>
          </a>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Dernières réservations -->
  <div class="card lg:col-span-2">
    <div class="p-5 border-b border-gray-700">
      <h3 class="font-semibold">Dernières réservations</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-700/50">
          <tr>
            <th class="text-left px-4 py-3 text-gray-400 font-medium">#</th>
            <th class="text-left px-4 py-3 text-gray-400 font-medium">Client</th>
            <th class="text-left px-4 py-3 text-gray-400 font-medium">Service</th>
            <th class="text-left px-4 py-3 text-gray-400 font-medium">Date</th>
            <th class="text-left px-4 py-3 text-gray-400 font-medium">Statut</th>
            <th class="text-right px-4 py-3 text-gray-400 font-medium">Total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700">
          <% recentBookings.forEach(b => { %>
            <tr class="hover:bg-gray-700/30 transition-colors">
              <td class="px-4 py-3"><a href="/admin/bookings/<%= b.id %>" class="text-red-400 hover:text-red-300">#<%= b.id %></a></td>
              <td class="px-4 py-3 font-medium"><%= b.customer.name %></td>
              <td class="px-4 py-3 text-gray-400"><%= b.service?.name || '—' %></td>
              <td class="px-4 py-3 text-gray-400"><%= new Date(b.date).toLocaleDateString('fr-FR') %></td>
              <td class="px-4 py-3">
                <span class="badge-<%= b.status === 'new' ? 'new' : b.status === 'confirmed' ? 'confirm' : b.status === 'in_progress' ? 'progress' : b.status === 'done' ? 'done' : 'cancel' %>">
                  <%= b.status === 'new' ? 'Nouveau' : b.status === 'confirmed' ? 'Confirmé' : b.status === 'in_progress' ? 'En cours' : b.status === 'done' ? 'Terminé' : 'Annulé' %>
                </span>
              </td>
              <td class="px-4 py-3 text-right font-semibold text-orange-400"><%= b.totalPrice.toFixed(2) %> €</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/admin-foot') %>
