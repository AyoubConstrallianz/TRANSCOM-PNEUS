<%- include('../../partials/admin-head') %>

<div class="max-w-2xl">
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/tires" class="text-gray-400 hover:text-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <h2 class="text-2xl font-bold"><%= title %></h2>
  </div>

  <% if (errors) { %>
    <div class="bg-red-900/50 border border-red-700 rounded-lg p-4 mb-6">
      <ul class="list-disc list-inside text-red-300 text-sm space-y-1">
        <% errors.forEach(e => { %><li><%= e.message %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="POST" action="<%= tire?.id ? '/admin/tires/' + tire.id : '/admin/tires' %>" enctype="multipart/form-data" class="card p-6 space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="grid sm:grid-cols-2 gap-5">
      <div>
        <label class="form-label">Marque *</label>
        <input class="form-input" type="text" name="brand" value="<%= tire?.brand || '' %>" required placeholder="ex: Michelin">
      </div>
      <div>
        <label class="form-label">Modèle *</label>
        <input class="form-input" type="text" name="model" value="<%= tire?.model || '' %>" required placeholder="ex: Pilot Sport 4">
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <label class="form-label">Largeur (mm) *</label>
        <input class="form-input" type="number" name="width" value="<%= tire?.width || '' %>" required placeholder="205">
      </div>
      <div>
        <label class="form-label">Rapport (%) *</label>
        <input class="form-input" type="number" name="ratio" value="<%= tire?.ratio || '' %>" required placeholder="55">
      </div>
      <div>
        <label class="form-label">Diamètre (") *</label>
        <input class="form-input" type="number" name="diameter" value="<%= tire?.diameter || '' %>" required placeholder="16">
      </div>
    </div>

    <div>
      <label class="form-label">Saison *</label>
      <select class="form-select" name="season" required>
        <option value="">-- Choisir --</option>
        <option value="summer"    <%= tire?.season === 'summer'    ? 'selected' : '' %>>Été</option>
        <option value="winter"    <%= tire?.season === 'winter'    ? 'selected' : '' %>>Hiver</option>
        <option value="allseason" <%= tire?.season === 'allseason' ? 'selected' : '' %>>4 saisons</option>
      </select>
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      <div>
        <label class="form-label">Prix d'achat (€) *</label>
        <input class="form-input" type="number" step="0.01" name="buyPrice" value="<%= tire?.buyPrice || '' %>" required placeholder="80.00">
      </div>
      <div>
        <label class="form-label">Prix de vente (€) *</label>
        <input class="form-input" type="number" step="0.01" name="sellPrice" value="<%= tire?.sellPrice || '' %>" required placeholder="129.00">
      </div>
      <div>
        <label class="form-label">Stock *</label>
        <input class="form-input" type="number" name="stock" value="<%= tire?.stock ?? 0 %>" required min="0">
      </div>
    </div>

    <div>
      <label class="form-label">Description</label>
      <textarea class="form-input" name="description" rows="3" placeholder="Description optionnelle..."><%= tire?.description || '' %></textarea>
    </div>

    <div>
      <label class="form-label">Photo</label>
      <% if (tire?.imageUrl) { %>
        <div class="mb-2">
          <img src="<%= tire.imageUrl %>" alt="" class="w-24 h-24 object-cover rounded-lg">
          <p class="text-xs text-gray-500 mt-1">Choisir une nouvelle image pour remplacer</p>
        </div>
      <% } %>
      <input class="form-input py-2" type="file" name="image" accept="image/jpeg,image/png,image/webp">
      <p class="text-xs text-gray-500 mt-1">JPG, PNG ou WebP — max 5 Mo</p>
    </div>

    <label class="flex items-center gap-3 cursor-pointer">
      <input type="checkbox" name="active" class="w-4 h-4 rounded" <%= !tire || tire.active !== false ? 'checked' : '' %>>
      <span class="text-sm text-gray-300">Pneu actif (visible dans le catalogue)</span>
    </label>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="btn-primary"><%= tire?.id ? 'Enregistrer les modifications' : 'Créer le pneu' %></button>
      <a href="/admin/tires" class="btn-outline">Annuler</a>
    </div>
  </form>
</div>

<%- include('../../partials/admin-foot') %>
