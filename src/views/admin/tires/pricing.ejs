<%- include('../../partials/admin-head') %>

<div class="mb-6">
  <h2 class="text-2xl font-bold">Gestion des prix</h2>
  <p class="text-gray-400 text-sm mt-1">Modification en masse ou ligne par ligne</p>
</div>

<!-- Modification en masse -->
<div class="card p-6 mb-8">
  <h3 class="font-semibold mb-4">Modification en masse</h3>
  <form method="POST" action="/admin/tires/pricing/bulk" class="flex flex-wrap gap-4 items-end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label class="form-label">Type</label>
      <select name="type" class="form-select py-2">
        <option value="percent">Hausse en %</option>
        <option value="fixed">Montant fixe (€)</option>
      </select>
    </div>
    <div>
      <label class="form-label">Valeur</label>
      <input class="form-input py-2 w-28" type="number" step="0.01" name="value" required placeholder="ex: 5">
    </div>
    <div>
      <label class="form-label">Marque (laisser vide = toutes)</label>
      <select name="brand" class="form-select py-2">
        <option value="">Toutes les marques</option>
        <% brands.forEach(b => { %><option value="<%= b.brand %>"><%= b.brand %></option><% }) %>
      </select>
    </div>
    <div>
      <label class="form-label">Appliquer à</label>
      <select name="applyTo" class="form-select py-2">
        <option value="sellPrice">Prix de vente seulement</option>
        <option value="both">Prix achat + vente</option>
      </select>
    </div>
    <button type="submit" class="btn-primary py-2 px-5" onclick="return confirm('Appliquer la modification en masse ?')">Appliquer</button>
  </form>
</div>

<!-- Tableau ligne par ligne -->
<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-gray-700/50">
      <tr>
        <th class="text-left px-4 py-3 text-gray-400 font-medium">Pneu</th>
        <th class="text-left px-4 py-3 text-gray-400 font-medium">Dimension</th>
        <th class="text-right px-4 py-3 text-gray-400 font-medium">Stock</th>
        <th class="px-4 py-3 text-gray-400 font-medium">Prix achat (€)</th>
        <th class="px-4 py-3 text-gray-400 font-medium">Prix vente (€)</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-700">
      <% tires.forEach(t => { %>
        <tr>
          <td class="px-4 py-3">
            <p class="font-medium"><%= t.brand %></p>
            <p class="text-gray-400 text-xs"><%= t.model %></p>
          </td>
          <td class="px-4 py-3 font-mono text-xs"><%= t.width %>/<%= t.ratio %> R<%= t.diameter %></td>
          <td class="px-4 py-3 text-right">
            <span class="<%= t.stock <= 3 ? 'text-red-400' : 'text-gray-400' %>"><%= t.stock %></span>
          </td>
          <form method="POST" action="/admin/tires/<%= t.id %>/price" class="contents">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <td class="px-4 py-2">
              <input type="number" name="buyPrice" step="0.01" value="<%= t.buyPrice.toFixed(2) %>" class="form-input py-1.5 text-sm w-28">
            </td>
            <td class="px-4 py-2">
              <input type="number" name="sellPrice" step="0.01" value="<%= t.sellPrice.toFixed(2) %>" class="form-input py-1.5 text-sm w-28">
            </td>
            <td class="px-4 py-3">
              <button type="submit" class="text-xs bg-blue-700 hover:bg-blue-600 text-white px-3 py-1.5 rounded transition-colors">Sauvegarder</button>
            </td>
          </form>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/admin-foot') %>
