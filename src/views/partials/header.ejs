<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
  <% } %>
  <!-- Open Graph -->
  <meta property="og:title"       content="<%= title %>">
  <meta property="og:type"        content="website">
  <meta property="og:url"         content="https://transcompneus.fr<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  <meta property="og:image"       content="https://transcompneus.fr/images/logo.png">
  <meta property="og:site_name"   content="TRANSCOM PNEUS">
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
  <meta property="og:description" content="<%= metaDescription %>">
  <% } %>
  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary">
  <meta name="twitter:title"       content="<%= title %>">
  <% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
  <meta name="twitter:description" content="<%= metaDescription %>">
  <% } %>
  <!-- Robots & Canonical -->
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://transcompneus.fr<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Fugaz+One&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/tailwind.css">
  <!-- JSON-LD LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AutoRepair",
    "@id": "https://transcompneus.fr/#business",
    "name": "TRANSCOM PNEUS",
    "description": "Dépannage pneu à domicile, montage, réparation de crevaison, équilibrage et soudure en Île-de-France. Intervention 7j/7 et 24h/24.",
    "url": "https://transcompneus.fr",
    "telephone": "<%= phone %>",
    "email": "contact@transcompneus.fr",
    "image": "https://transcompneus.fr/images/logo.png",
    "priceRange": "€€",
    "currenciesAccepted": "EUR",
    "paymentAccepted": "Cash, Carte bancaire",
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "00:00", "closes": "23:59" }
    ],
    "areaServed": [
      { "@type": "City", "name": "Paris", "containedInPlace": { "@type": "State", "name": "Île-de-France" } },
      { "@type": "AdministrativeArea", "name": "Seine-et-Marne (77)" },
      { "@type": "AdministrativeArea", "name": "Yvelines (78)" },
      { "@type": "AdministrativeArea", "name": "Essonne (91)" },
      { "@type": "AdministrativeArea", "name": "Hauts-de-Seine (92)" },
      { "@type": "AdministrativeArea", "name": "Seine-Saint-Denis (93)" },
      { "@type": "AdministrativeArea", "name": "Val-de-Marne (94)" },
      { "@type": "AdministrativeArea", "name": "Val-d'Oise (95)" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Prestations TRANSCOM PNEUS",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dépannage pneu à domicile", "description": "Intervention rapide pour crevaison, pneu à plat, changement de pneu à votre domicile ou sur votre lieu de travail en Île-de-France." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Montage de pneus à domicile", "description": "Montage et démontage de pneus à votre domicile. Équilibrage inclus. Tous types de véhicules." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Soudure à domicile", "description": "Soudure acier, dépannage soudure, réparation de pièces métalliques et travaux sur mesure en Île-de-France." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Réparation de crevaison", "description": "Réparation rapide d'un pneu crevé sans remplacement. Intervention dans l'heure." } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Équilibrage de roues", "description": "Équilibrage précis de vos roues pour éliminer les vibrations et usure prématurée." } }
      ]
    },
    "sameAs": []
  }
  </script>
</head>
<body class="bg-zinc-950 text-gray-100 min-h-screen flex flex-col">

<!-- Navigation -->
<nav class="bg-black border-b border-zinc-800 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-24">

      <!-- Logo -->
      <a href="/" class="flex items-center py-2">
        <img src="/images/logo-header.png.png" alt="TRANSCOM PNEUS" class="h-14 w-auto">
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center gap-6">
        <div class="relative group">
          <a href="/services" class="text-sm font-medium text-zinc-300 hover:text-yellow-400 transition-colors flex items-center gap-1 <%= ['/services','/depannage-pneu','/crevaison-voiture','/crevaison-camion','/soudure-domicile','/montage-pneu-domicile','/equilibrage-roues'].includes(currentPath) ? 'text-yellow-400' : '' %>">
            Services
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute top-full left-0 mt-2 w-56 bg-zinc-900 border border-zinc-700 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-2">
              <a href="/depannage-pneu"        class="block px-4 py-2 text-sm text-zinc-300 hover:text-yellow-400 hover:bg-zinc-800">Dépannage pneu</a>
              <a href="/montage-pneu-domicile" class="block px-4 py-2 text-sm text-zinc-300 hover:text-yellow-400 hover:bg-zinc-800">Montage pneu à domicile</a>
              <a href="/crevaison-voiture"     class="block px-4 py-2 text-sm text-zinc-300 hover:text-yellow-400 hover:bg-zinc-800">Crevaison voiture</a>
              <a href="/crevaison-camion"      class="block px-4 py-2 text-sm text-zinc-300 hover:text-yellow-400 hover:bg-zinc-800">Crevaison camion</a>
              <a href="/soudure-domicile"      class="block px-4 py-2 text-sm text-zinc-300 hover:text-yellow-400 hover:bg-zinc-800">Soudure à domicile</a>
              <a href="/equilibrage-roues"     class="block px-4 py-2 text-sm text-zinc-300 hover:text-yellow-400 hover:bg-zinc-800">Équilibrage</a>
              <div class="border-t border-zinc-700 my-1"></div>
              <a href="/services"              class="block px-4 py-2 text-sm text-yellow-400 font-semibold hover:bg-zinc-800">Tous les services →</a>
            </div>
          </div>
        </div>
        <a href="/contact"    class="text-sm font-medium text-zinc-300 hover:text-yellow-400 transition-colors <%= currentPath === '/contact'    ? 'text-yellow-400' : '' %>">Contact</a>
        <a href="tel:<%= phone %>" class="flex items-center gap-1.5 text-sm font-semibold text-yellow-400 hover:text-yellow-300 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <%= phone %>
        </a>
        <a href="/reservation" class="btn-primary py-2 px-5">Prendre RDV</a>
      </div>

      <!-- Mobile menu btn -->
      <button id="nav-toggle" class="md:hidden text-zinc-300 hover:text-yellow-400 p-2">
        <svg id="nav-icon-open"  class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="nav-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
  <!-- Mobile menu -->
  <div id="nav-menu" class="hidden md:hidden border-t border-zinc-800 bg-black">
    <div class="px-4 py-3 space-y-2">
      <a href="/services"              class="block py-2.5 text-zinc-300 hover:text-yellow-400 font-medium">Tous les services</a>
      <a href="/depannage-pneu"        class="block py-2 pl-4 text-zinc-400 hover:text-yellow-400 text-sm">Dépannage pneu</a>
      <a href="/crevaison-voiture"     class="block py-2 pl-4 text-zinc-400 hover:text-yellow-400 text-sm">Crevaison voiture</a>
      <a href="/soudure-domicile"      class="block py-2 pl-4 text-zinc-400 hover:text-yellow-400 text-sm">Soudure à domicile</a>
      <a href="/contact"               class="block py-2.5 text-zinc-300 hover:text-yellow-400 font-medium">Contact</a>
      <a href="tel:<%= phone %>" class="block py-2.5 text-yellow-400 font-semibold">📞 <%= phone %></a>
      <a href="/reservation" class="btn-primary block text-center mt-3 py-3">Prendre RDV</a>
    </div>
  </div>
</nav>

<main class="flex-1">
